# Ключ Claude API (console.anthropic.com). Без него бот соберёт пост из заголовка новости без переписывания.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Instagram Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# Где хранить картинку, чтобы Instagram мог её скачать: github или imgbb
IMAGE_HOST=github
# для IMAGE_HOST=github (в GitHub Actions заполняются сами; репозиторий должен быть публичным)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
# для IMAGE_HOST=imgbb (бесплатный ключ на api.imgbb.com)
IMGBB_API_KEY=

# Оформление
CHANNEL_HANDLE=@bucho2
# Публиковать по-настоящему только если true. Иначе только сохраняет картинку и подпись в output/
PUBLISH=false
